{
  "name": "transco-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Transco Consolidation customer shipment dashboard: track & trace, vessel positions and scheduled email updates",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "notify:once": "node --disable-warning=ExperimentalWarning scripts/notify-once.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.3.1"
  }
}
