# Copy to .env and fill in. Everything is optional: with no settings the portal runs with demo tracking data
# and writes emails to data/outbox/ instead of sending them.

PORT=3000
HOST=                                   # 127.0.0.1 when behind Caddy/nginx so only the proxy can reach the app
APP_URL=http://localhost:3000          # public address of the portal, used in email links
NODE_ENV=development                    # set to production behind HTTPS
SESSION_SECRET=                         # long random string (generated automatically if empty)
COMPANY_NAME=Transco Consolidation
SUPPORT_EMAIL=                          # shown to customers, e.g. customerservice@yourdomain
SIGNUP_CODE=                            # if set, customers need this code to create an account

# ---- Track & trace ----
TRACKING_PROVIDER=demo                  # demo | http
TRACKING_API_URL=                       # e.g. https://tracking.example.com/v1/track?ref={reference}&carrier={carrier}
TRACKING_API_KEY=
TRACKING_API_KEY_HEADER=Authorization   # "Authorization" sends "Bearer <key>"; any other header sends the key as is
TRACKING_CACHE_MINUTES=15
TRANSCO_TRACKING_URL=                   # your own public track & trace page, e.g. https://track.example.com/?ref={reference}

# ---- MarineTraffic (live vessel positions) ----
MARINETRAFFIC_API_KEY=                  # API key for the "Single Vessel Positions" (PS07) service
MARINETRAFFIC_TIMESPAN=60
MARINETRAFFIC_CACHE_MINUTES=10

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Transco Consolidation <tracking@yourdomain>"

# ---- Email update scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30
